<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <!--The Exhibit's Page: where the pictures are displayed-->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors" />
    <meta name="generator" content="Astro v5.13.2" />
    <title>Exhibit</title>
    <link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/album/" />
    <script src="../assets/js/color-modes.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="frontend/style.css" rel="stylesheet">
    <meta name="theme-color" content="#712cf9" />
  </head>
  
  <body>
    <header>
      <div class="navbar shadow-sm">
        <div class="container">
          <a href="/rooms/<%= room.room_id %>" class="navbar-brand d-flex align-items-center"></a>          
            <img style="width: 50px; height: auto;" src="/logo.svg">
            <strong>AA Galleries</strong>
          </a>
          <div>
            <ul style="display:flex; list-style-type: none; gap: 10px">
                <li class="nav-item">
                  <form method="post" action="/api/events/rooms/<%= room.room_id %>/leave">
                    <button type="submit" class="nav-link btn btn-link">Exit Room</button>
                  </form>
                </li>
                <li>
                  <form action="/api/auth/logout" method="POST"><button type="submit" style="border:none; background:none; padding: 0;">Logout</button></form>
                </li>
            </ul>
          </div>
        </div>
      </div>
    </header>
    <main>
      <div class="album py-4 bg-body-tertiary">
        <div class="container">
          <section class="py-4 text-center position-relative">
            <form method="post" action="/api/events/rooms/<%= room.room_id %>/leave" class="position-absolute start-0">
              <button type="submit" class="btn">&laquo; Exit Room</button>
            </form>             
                <h1 class="fw-light">
                    <%= room.name %>
                </h1>
            </section>
            <!--Template for loading the paintings from the database-->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                <% paintings.forEach(painting => { %>
                    <div class="col">
                        <div class="card shadow-sm">
                            <% if (painting.image_url) { %>
                                <img src="/<%= painting.image_url %>" class="card-img-top" alt="<%= painting.name %>">
                            <% } else { %>
                                <img src="/placeholder.png" class="card-img-top" alt="No image available">
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
      </div>
    </main>
    <script
      src="../assets/dist/js/bootstrap.bundle.min.js"
      class="astro-vvvwv3sm"
    ></script>
  </body>
</html>
