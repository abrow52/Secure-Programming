<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <!--The Home Page: The galleries are displayed here-->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors" />
    <meta name="generator" content="Astro v5.13.2" />
    <title>Home</title>
    <link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/album/" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="frontend/style.css" rel="stylesheet">
    <meta name="theme-color" content="#712cf9" />
  </head>
  
  <body>
    <header>
      <div class="navbar shadow-sm">
        <div class="container">
          <a href="/" class="navbar-brand d-flex align-items-center">
            <img style="width: 50px; height: auto;" src="/logo.svg">
            <strong>AA Galleries</strong>
          </a>
          <div>
            <ul style="display:flex; list-style-type: none; gap: 10px">
                <li class="nav-item"><a class="nav-link" aria-current="page" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="login">Login</a></li>
                <% if (user && (user.role === "admin" || user.role === "employee")) { %>
                  <li class="nav-item">
                      <a class="nav-link" href="/events">Events</a>
                  </li>
                <% } %>
                <% if (user && user.role === "admin") { %>
                  <li class="nav-item">
                      <a class="nav-link" href="/users">Users</a>
                  </li>
                <% } %>
            </ul>
          </div>
        </div>
      </div>
    </header>
    <main>
      <section class="py-4 text-center container">
        <div class="row py-lg-5">
          <div class="col-lg-6 col-md-8 mx-auto">
            <!-- <h1 class="fw-light">Welcome to AA Galeries!</h1> -->
            <h1 class="fw-light">
              Welcome to AA Galleries, <% if (user) { %> <%= user.username %><% } %>!
            </h1>
            <p class="lead text-body-secondary">
              Please Browse at Your Leisure!
            </p>
          </div>
        </div>
      </section>
      <div class="album py-4 bg-body-tertiary">
        <% if (user && (user.role === "admin" || user.role === "employee" || user.role === "guest")) { %>
        <div class="container">
          <!--Template for loading the galleries from the database-->
          <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3"> 
            <% galleries.forEach(gallery => { %>
              <div class="col">
                <div class="card shadow-sm">
                  <% if (gallery.image_url) { %>
                    <img src="/<%= gallery.image_url %>" class="card-img-top" alt="<%= gallery.name %>">
                  <% } else { %>
                      <img src="/placeholder.png" class="card-img-top" alt="No image available">
                  <% } %>
                  <div class="card-body">
                    <h5 class="card-title">
                        <%= gallery.name %>
                    </h5>
                    <p class="card-text">
                        <%= gallery.description %>
                    </p>
                    <div class="d-flex justify-content-between align-items-center">
                      <div class="btn-group">
                        <a href="/galleries/<%= gallery.gallery_id %>" class="btn btn-sm btn-outline-secondary">
                            Enter Gallery
                        </a>
                      </div>
                      <small class="text-body-secondary">
                        <p>Ocupancy:  </p>
                        <!-- <%= gallery.capacity %> -->
                      </small>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>
      </div>
    </main>
    <script
      src="../assets/dist/js/bootstrap.bundle.min.js"
      class="astro-vvvwv3sm"
    ></script>
  </body>
</html>
