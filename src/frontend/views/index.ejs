<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <!--The Home Page: The galleries are displayed here-->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors" />
    <meta name="generator" content="Astro v5.13.2" />
    <title>Home</title>
    <link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/album/" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="frontend/style.css" rel="stylesheet">
    <meta name="theme-color" content="#712cf9" />
  </head>
  
  <body>
    <header>
      <div class="navbar shadow-sm">
        <div class="container">
          <a class="navbar-brand d-flex align-items-center">
            <img style="width: 50px; height: auto;" src="/logo.svg">
            <strong>AA Galleries</strong>
          </a>
          <div>
            <ul style="display:flex; list-style-type: none; gap: 10px">
                <li class="nav-item"><a class="nav-link" aria-current="page" href="/">Home</a></li>
                <% if (!user) { %>
                  <li class="nav-item"><a class="nav-link" href="login">Login</a></li>
                <% } %>
                <% if (user && user.role) { %>
                  <li>
                    <form action="/api/auth/logout" method="POST"><button type="submit" style="border:none; background:none; padding: 0;">Logout</button></form>
                  </li>
                <% } %>
                <% if (user && (user.role === "admin" || user.role === "employee")) { %>
                  <li class="nav-item">
                      <a class="nav-link" href="/events">Events</a>
                  </li>
                <% } %>
                <% if (user && user.role === "admin") { %>
                  <li class="nav-item">
                      <a class="nav-link" href="/audit">Audit Log</a>
                  </li>                    
                  <li class="nav-item">
                      <a class="nav-link" href="/users">Users</a>
                  </li>
                <% } %>
            </ul>
          </div>
        </div>
      </div>
    </header>
    <main>
      <section class="py-4 text-center container">
        <div class="row py-lg-5">
          <div class="col-lg-6 col-md-8 mx-auto">
            <!-- <h1 class="fw-light">Welcome to AA Galeries!</h1> -->
            <h1 class="fw-light">
              Welcome to AA Galleries, <% if (user) { %> <%= user.username %><% } %>!
            </h1>
            <p class="lead text-body-secondary">
              Please Browse at Your Leisure!
            </p>
          </div>
        </div>
      </section>
      <div class="album py-4 bg-body-tertiary">
        <% if (user && (user.role === "admin" || user.role === "employee" || user.role === "guest")) { %>
        <div class="container">
          <!--Template for loading the galleries from the database-->
          <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3"> 
            <% galleries.forEach(gallery => { %>
              <div class="col">
                <div class="card shadow-sm">
                  <% if (gallery.image_url) { %>
                    <img src="/<%= gallery.image_url %>" class="card-img-top" alt="<%= gallery.name %>">
                  <% } else { %>
                      <img src="/placeholder.png" class="card-img-top" alt="No image available">
                  <% } %>
                  <div class="card-body">
                    <h5 class="card-title">
                        <%= gallery.name %>
                    </h5>
                    <p class="card-text">
                        <%= gallery.description %>
                    </p>
                    <div class="d-flex justify-content-between align-items-center">
                      <div class="btn-group">
                        <form data-enter-gallery method="post" action="/api/events/galleries/<%= gallery.gallery_id %>/enter">
                          <button type="submit" class="btn btn-sm btn-outline-secondary">          
                          Enter Gallery
                          </button>
                        </form>                         
                      </div>
                      <% if (user && (user.role === "admin" || user.role === "employee")) { %>
                        <small class="text-body-secondary">
                          <p> Occupants: <%= gallery.occupantCount %> </p>
                        </small>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>
      </div>
    </main>
    <script src="../assets/dist/js/bootstrap.bundle.min.js"class="astro-vvvwv3sm"></script>
    <script>
      let reconcilingHistory = false;

      async function reconcileHomeHistory() {
        const marker = history.state?.galleryHistoryMarker;

        if (!marker || reconcilingHistory) return;

        reconcilingHistory = true;

        try {
          const response = await fetch("/api/events/history/reconcile", {
            method: "POST",
            credentials: "same-origin",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            cache: "no-store",
            body: JSON.stringify({
              marker: marker,
              destination: "/"
            })
          });

          const data = await response.json().catch(() => ({}));

          if (!response.ok || !data.ok) {
            console.error("History reconciliation failed:", data);
            reconcilingHistory = false;
            return;
          }

          // remove the marker before reloading the page so the so the same request isn't submitted
          const newState = { ...(history.state || {}) };
          delete newState.galleryHistoryMarker;

          history.replaceState(newState, "", window.location.href);
          window.location.reload();
        } catch (error) {
          console.error("Unable to reconcile home-page history:", error);
          reconcilingHistory = false;
        }
      }

      window.addEventListener("popstate", reconcileHomeHistory);
      window.addEventListener("pageshow", reconcileHomeHistory);
    </script>
    <script>
      document.querySelectorAll("form[data-enter-gallery]").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
      
          try {
            const response = await fetch(form.action, {
              method: "POST",
              headers: {
                Accept: "application/json"
              },
              credentials: "same-origin"
            });
      
            const data = await response.json();
      
            if (!response.ok) {
              alert(data.error || "Unable to enter gallery");
              return;
            }
      
            // mark home page before leaving
            history.replaceState(
              {
                ...(history.state || {}),
                galleryHistoryMarker: data.marker
              },
              "",
              window.location.href
            );
      
            window.location.href = data.redirect;
          } catch (error) {
            console.error("Enter Gallery failed:", error);
            alert("Unable to enter gallery. Please try again.");
          }
        });
      });
    </script>
  
  </body>
</html>
