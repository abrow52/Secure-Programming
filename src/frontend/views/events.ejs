<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <!--The Events Page: Employees and Admin can see the history of events (people leaving and entering rooms and galleries)-->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors" />
    <meta name="generator" content="Astro v5.13.2" />
    <title>Room</title>
    <link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/album/" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="frontend/style.css" rel="stylesheet">
    <meta name="theme-color" content="#712cf9" />
  </head>
  
  <body>
    <header>
      <div class="navbar shadow-sm">
        <div class="container">
          <a href="/" class="navbar-brand d-flex align-items-center">
            <img style="width: 50px; height: auto;" src="/logo.svg">
            <strong>AA Galleries</strong>
          </a>
          <div>
            <ul style="display:flex; list-style-type: none; gap: 10px">
                <li class="nav-item"><a class="nav-link" aria-current="page" href="/">Home</a></li>
                <li>
                  <form action="/api/auth/logout" method="POST"><button type="submit" style="border:none; background:none; padding: 0;">Logout</button></form>
                </li>
                <% if (user && (user.role === "admin" || user.role === "employee")) { %>
                  <li class="nav-item">
                      <a class="nav-link" href="/events">Events</a>
                  </li>
                <% } %>
                <% if (user && user.role === "admin") { %>
                  <li class="nav-item">
                      <a class="nav-link" href="/audit">Audit Log</a>
                  </li>
                  <li class="nav-item">
                      <a class="nav-link" href="/users">Users</a>
                  </li>
                <% } %>
            </ul>
          </div>
        </div>
      </div>
    </header>
    <main class="container py-4">
      <h1>Gallery and Room Events</h1>

      <section class="mt-4">
        <h2>Gallery events</h2>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr><th>User</th><th>Gallery</th><th>Action</th><th>Time</th></tr>
            </thead>
            <tbody>
              <% galleryEvents.forEach(event => { %>
                <tr>
                  <td><%= event.username %></td>
                  <td><%= event.gallery_name %></td>
                  <td><%= event.type %></td>
                  <td><%= event.occurred_at %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-4">
        <h2>Room events</h2>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr><th>User</th><th>Gallery</th><th>Room</th><th>Action</th><th>Time</th></tr>
            </thead>
            <tbody>
              <% roomEvents.forEach(event => { %>
                <tr>
                  <td><%= event.username %></td>
                  <td><%= event.gallery_name %></td>
                  <td><%= event.room_name %></td>
                  <td><%= event.type %></td>
                  <td><%= event.occurred_at %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>