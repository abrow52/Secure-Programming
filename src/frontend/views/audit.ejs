<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <!--The Audit log page: Admin can see the history of actions (people leaving and entering rooms and galleries)
    ,resource IDs, and IP addresses-->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors" />
    <meta name="generator" content="Astro v5.13.2" />
    <title>Room</title>
    <link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/album/" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="frontend/style.css" rel="stylesheet">
    <meta name="theme-color" content="#712cf9" />
  </head>
  
  <body>
    <header>
      <div class="navbar shadow-sm">
        <div class="container">
          <a class="navbar-brand d-flex align-items-center">
            <img style="width: 50px; height: auto;" src="/logo.svg">
            <strong>AA Galleries</strong>
          </a>
          <div>
            <ul style="display:flex; list-style-type: none; gap: 10px">
                <li class="nav-item"><a class="nav-link" aria-current="page" href="/">Home</a></li>
                <li>
                  <form action="/api/auth/logout" method="POST">
                    <button type="submit" style="border:none; background:none; padding: 0;">Logout</button>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                  </form>
                </li>
                <% if (user && (user.role === "admin" || user.role === "employee")) { %>
                  <li class="nav-item">
                      <a class="nav-link" href="/events">Events</a>
                  </li>
                <% } %>
                <% if (user && user.role === "admin") { %>
                  <li class="nav-item">
                      <a class="nav-link" href="/audit">Audit Log</a>
                  </li>                    
                  <li class="nav-item">
                      <a class="nav-link" href="/users">Users</a>
                  </li>
                <% } %>
            </ul>
          </div>
        </div>
      </div>
    </header>
    <main class="container py-4">
      <h1 style="text-align: center;">Audit Log</h1>

      <section class="mt-4">        
        <form action="/audit" method="GET" class="row g-3 mb-4">
          <div class="col-md-3">
            <label for="userFilter" class="form-label">User</label>
            <input
              type="text"
              class="form-control"
              id="userFilter"
              name="user"
              placeholder="Search username"
              value="<%= filters.user %>"
            >
          </div>

          <div class="col-md-3">
            <label for="actionFilter" class="form-label">Action</label>
            <input
              type="text"
              class="form-control"
              id="actionFilter"
              name="action"
              placeholder="e.g. LOGIN_SUCCESS"
              value="<%= filters.action %>"
            >
          </div>

          <div class="col-md-3">
            <label for="ipFilter" class="form-label">IP Address</label>
            <input
              type="text"
              class="form-control"
              id="ipFilter"
              name="ip"
              placeholder="Search IP address"
              value="<%= filters.ip %>"
            >
          </div>

          <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a href="/audit" class="btn btn-outline-secondary">Clear</a>
          </div>
        </form>

        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr><th>User</th><th>Action</th><th>Resource</th><th>Resource ID</th><th>IP address</th><th>Time</th></tr>
            </thead>
            <tbody>
              <% auditLogs.forEach(log => { %>
                <tr>
                  <td><%= log.username || "Deleted user" %></td>
                  <td><%= log.action %></td>
                  <td><%= log.resource_type || "" %></td>
                  <td><%= log.resource_id || "" %></td>
                  <td><%= log.ip_address || "" %></td>
                  <td><%= log.occurred_at %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>