<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <!--The Rooms Page: Where the rooms in the selected gallery are displayed-->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors" />
    <meta name="generator" content="Astro v5.13.2" />
    <title>Room</title>
    <link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/album/" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="frontend/style.css" rel="stylesheet">
    <meta name="theme-color" content="#712cf9" />
  </head>
  
  <body>
    <header>
      <div class="navbar shadow-sm">
        <div class="container">
            <img style="width: 50px; height: auto;" src="/logo.svg">
            <strong>AA Galleries</strong>
          </a>
          <div>
            <ul style="display:flex; list-style-type: none; gap: 10px">
                <li class="nav-item">
                  <form method="post" action="/api/events/galleries/<%= gallery.gallery_id %>/leave">
                    <button type="submit" class="nav-link btn btn-link">Exit Gallery</button>
                  </form>
                </li>                
                <li>
                  <form action="/api/auth/logout" method="POST"><button type="submit" style="border:none; background:none; padding: 0;">Logout</button></form>
                </li>
            </ul>
          </div>
        </div>
      </div>
    </header>
    <main>
      <div class="container">
        <!--Template for loading the rooms from the database-->
        <section class="py-5 text-center position-relative">
          <form method="post" action="/api/events/galleries/<%= gallery.gallery_id %>/leave" class="position-absolute start-0">
            <button type="submit" class="btn">&laquo; Exit Gallery</button>
          </form>           
            <h1 class="fw-light">
                <%= gallery.name %>
            </h1>
        </section>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 g-2">
          <% rooms.forEach(room => { %>
            <div class="col">
              <div class="card shadow-sm">
                <% if (room.image_url) { %>
                  <img src="/<%= room.image_url %>" class="card-img-top" alt="<%= room.name %>">
                <% } else { %>
                    <img src="/placeholder.png" class="card-img-top" alt="No image available">
                <% } %>
                <div class="card-body">
                  <h5 class="card-title">
                      <%= room.name %>
                  </h5>
                  <p class="card-text">
                      <%= room.description %>
                  </p>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="btn-group">
                      <form method="post" action="/api/events/rooms/<%= room.room_id %>/enter">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                      Enter Room
                        </button>
                      </form>                      
                    </div>
                    <small class="text-body-secondary">
                      <p>Ocupancy:  </p>
                        <!-- <%= room.capacity %> -->
                    </small>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </main>
    <script
      src="../assets/dist/js/bootstrap.bundle.min.js"
      class="astro-vvvwv3sm"
    ></script>
  </body>
</html>
