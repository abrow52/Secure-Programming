<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <!--The Users Page: Where the list of users is displayed and admin can make new users-->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors" />
    <meta name="generator" content="Astro v5.13.2" />
    <title>Users</title>
    <link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/album/" />
    <script src="../assets/js/color-modes.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="frontend/style.css" rel="stylesheet">
    <meta name="theme-color" content="#712cf9" />
  </head>
  
  <body>
    <header>
      <div class="navbar shadow-sm">
        <div class="container">
          <a class="navbar-brand d-flex align-items-center">
            <img style="width: 50px; height: auto;" src="/logo.svg">
            <strong>AA Galleries</strong>
          </a>
          <div>
            <ul style="display:flex; list-style-type: none; gap: 10px">
                <li class="nav-item"><a class="nav-link" aria-current="page" href="/">Home</a></li>
                <li>
                    <form action="/api/auth/logout" method="POST">
                      <button type="submit" style="border:none; background:none; padding: 0;">Logout</button>
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                    </form>
                  </li>
                <% if (user && (user.role === "admin" || user.role === "employee")) { %>
                  <li class="nav-item">
                      <a class="nav-link" href="/events">Events</a>
                  </li>
                <% } %>
                <% if (user && user.role === "admin") { %>
                  <li class="nav-item">
                      <a class="nav-link" href="/audit">Audit Log</a>
                  </li>                    
                  <li class="nav-item">
                      <a class="nav-link" href="/users">Users</a>
                  </li>
                <% } %>
            </ul>
          </div>
        </div>
      </div>
    </header>
    <main>
      <div class="album py-5 bg-body-tertiary">
        <div class="container">
          <div id="user-message" class="alert d-none" role="alert" aria-live="polite"></div>
          <h2>Active Users</h2>
            <table id="users-table" class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let user of Users) { %>
                        <tr>
                            <td><%= user.user_id %></td>
                            <td><%= user.username %></td>
                            <td><%= user.role %></td>

                            <td class="text-center" style="gap: 30px;">
                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-secondary edit-user-btn"
                                    data-user-id="<%= user.user_id %>"
                                    data-username="<%= user.username %>"
                                    data-role="<%= user.role %>">
                                    Edit
                                </button>
                                <form
                                    action="/api/users/<%= user.user_id %>/delete"
                                    method="POST"
                                    class="delete-form"
                                    style="display: inline;"
                                >
                                  <button type="submit" class="btn btn-sm btn-danger">
                                    Delete
                                  </button>
                               </form>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

            <button onclick="unhideCreate()" class="btn btn-primary">Add New User</button>
            <div id="create-section" style="display: none; padding-top: 20px;">
                <h2>Add User</h2>
                <form id="create-user-form" action="/api/users" method="POST">
                  <table class="table table-striped table-bordered align-middle">
                      <thead class="table-dark">
                          <tr>
                              <th>Username</th>
                              <th>Password</th>
                              <th>Role</th>
                          </tr>
                      </thead>
                      <tbody>
                          <tr>
                              <td><input id="new-username" class="form-control" type="text" name="username" maxlength="50" required></td>
                              <td><input id="new-password" class="form-control" type="password" name="password" minlength="8" required></td>
                              <td>
                                <select id="new-role" name="role" class="form-select" required>
                                  <option value="guest">Guest</option>
                                  <option value="employee">Employee</option>
                                  <option value="admin">Admin</option>
                                </select>
                              </td>
                          </tr>
                      </tbody>
                  </table>
                  <div class="text-center" style="gap: 30px;">
                    <button type="submit" class="btn btn-primary">
                      Create User
                    </button>
                    <button type="button" onclick="hideCreate()" class="btn btn-danger">
                        Cancel
                    </button>
                  </div>
                </form>
            </div>

            <div id="edit-section" style="display: none; padding-top: 20px;">
              <form id="edit-user-form" method="POST">
                <h2>Edit User</h2>
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Username</th>
                            <th>Role</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><input id="edit-user-id" class="form-control" type="text" readonly></td>
                            <td><input id="edit-username" class="form-control" type="text" readonly></td>
                            <td>
                              <select id="edit-role" name="role" class="form-select" required>
                                <option value="guest">Guest</option>
                                <option value="employee">Employee</option>
                                <option value="admin">Admin</option>
                              </select>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="text-center" style="gap: 30px;">
                  <button type="submit" class="btn btn-primary">
                      Save Changes
                  </button>
                  <button
                      type="button"
                      id="cancel-edit"
                      class="btn btn-danger">
                      Cancel
                  </button>
                </div>
              </form>
          </div>
        </div>
      </div>
    </main>
    <script class="astro-vvvwv3sm">
        function unhideCreate() {
            document.getElementById("create-section").style.display = "block";
        }
        function hideCreate() {
            document.getElementById("create-section").style.display = "none";
        }

        const editSection = document.getElementById("edit-section");
        const editForm = document.getElementById("edit-user-form");

        document.querySelectorAll(".edit-user-btn").forEach(button => {
            button.addEventListener("click", () => {
                const userId = button.dataset.userId;
                const username = button.dataset.username;
                const role = button.dataset.role.toLowerCase();

                document.getElementById("edit-user-id").value = userId;
                document.getElementById("edit-username").value = username;
                document.getElementById("edit-role").value = role;

                editForm.action = `/api/users/${encodeURIComponent(userId)}/role`;

                editSection.style.display = "block";
                editSection.scrollIntoView({ behavior: "smooth" });
            });
        });

        document.getElementById("cancel-edit").addEventListener("click", () => {
            editSection.style.display = "none";
        });

        const userMessage = document.getElementById("user-message");

        function showUserMessage(message, success = false) {
            userMessage.textContent = message;
            userMessage.className = success
                ? "alert alert-success"
                : "alert alert-danger";

            userMessage.scrollIntoView({
                behavior: "smooth",
                block: "nearest"
            });
        }

        async function submitUserForm(form, options = {}) {
            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new URLSearchParams(new FormData(form))
                });

                const data = await response.json();

                if (!response.ok) {
                    showUserMessage(data.message || "Request failed.");
                    return false;
                }

                showUserMessage(data.message, true);

                if (options.onSuccess) {
                    options.onSuccess(data);
                }

                return true;
            } catch (error) {
                console.error("User request failed:", error);
                showUserMessage("Something went wrong. Please try again.");
                return false;
            }
        }

        // delete user
        document.querySelectorAll(".delete-form").forEach(form => {
            form.addEventListener("submit", async event => {
                event.preventDefault();

                if (!confirm("Are you sure you want to delete this user?")) {
                    return;
                }

                await submitUserForm(form, {
                    onSuccess: () => {
                        form.closest("tr").remove();
                    }
                });
            });
        });

        // change user role
        document.getElementById("edit-user-form")
            .addEventListener("submit", async event => {
                event.preventDefault();

                const form = event.currentTarget;
                const userId = document.getElementById("edit-user-id").value;
                const newRole = document.getElementById("edit-role").value;

                const success = await submitUserForm(form);

                if (success) {
                    // Update the displayed role in the table
                    const row = [...document.querySelectorAll("#users-table tbody tr")]
                        .find(row =>
                            row.cells[0].textContent.trim() === userId
                        );

                    if (row) {
                        row.cells[2].textContent = newRole;
                    }

                    document.getElementById("edit-section").style.display = "none";
                }
            });

        // create user
        document.getElementById("create-user-form")
            .addEventListener("submit", async event => {
                event.preventDefault();

                const form = event.currentTarget;
                const success = await submitUserForm(form);

                if (success) {
                    window.location.reload();
                }
            });
    </script>
  </body>
</html>
